{
  "name": "daily-games-speedrun",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bump": "npm version --no-git-tag-version",
    "version": "node scripts/sync-version.mjs",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:all": "npm --prefix ../website run sync:links && npm run package:source && npm run build",
    "build:chrome": "vite build --mode chrome && node scripts/zip-build.mjs chrome",
    "build:firefox": "vite build --mode firefox && node scripts/zip-build.mjs firefox",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "format": "prettier --write .",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.3",
    "@types/chrome": "^0.3.8",
    "fflate": "^0.8.3",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.1.3",
    "vite": "^6.2.0"
  }
}
