{
  "name": "Daily Games Speedrun",
  "description": "Speedrun your daily puzzle games.",
  "version": "0.0.4",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "action": {
    "default_title": "Open sidebar"
  },
  "sidebar_action": {
    "default_title": "Daily Games Speedrun",
    "default_panel": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "speedrundle@loyii91400",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/*",
        "https://minicrossword.com/*",
        "https://games.washingtonpost.com/*",
        "https://squaredle.app/*",
        "https://verticle.netlify.app/*",
        "https://www.thewikigamedaily.com/*",
        "https://bandle.app/*",
        "https://towerofquestions.com/*",
        "https://krillion.io/*",
        "https://patchguesser.site/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.nytimes.com/*",
        "https://minicrossword.com/*",
        "https://games.washingtonpost.com/*",
        "https://squaredle.app/*",
        "https://verticle.netlify.app/*",
        "https://www.thewikigamedaily.com/*",
        "https://bandle.app/*",
        "https://towerofquestions.com/*",
        "https://krillion.io/*",
        "https://patchguesser.site/*"
      ],
      "js": [
        "clipboard-listener.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
