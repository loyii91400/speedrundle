{
  "name": "Daily Games Speedrun",
  "description": "Speedrun your daily puzzle games.",
  "version": "0.0.5",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "action": {
    "default_title": "Open side panel"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/*",
        "https://minicrossword.com/*",
        "https://games.washingtonpost.com/*",
        "https://squaredle.app/*",
        "https://verticle.netlify.app/*",
        "https://www.thewikigamedaily.com/*",
        "https://bandle.app/*",
        "https://towerofquestions.com/*",
        "https://krillion.io/*",
        "https://patchguesser.site/*",
        "https://xordle.org/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.nytimes.com/*",
        "https://minicrossword.com/*",
        "https://games.washingtonpost.com/*",
        "https://squaredle.app/*",
        "https://verticle.netlify.app/*",
        "https://www.thewikigamedaily.com/*",
        "https://bandle.app/*",
        "https://towerofquestions.com/*",
        "https://krillion.io/*",
        "https://patchguesser.site/*",
        "https://xordle.org/*"
      ],
      "js": [
        "clipboard-listener.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
