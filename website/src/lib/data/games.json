{
  "categories": ["Words", "Trivia", "Music"],
  "games": [
    {
      "slug": "wordle",
      "name": "Wordle",
      "url": "https://www.nytimes.com/games/wordle/index.html",
      "matchPatterns": ["https://www.nytimes.com/games/wordle*"],
      "captureResults": true,
      "icon": "https://www.nytimes.com/games-assets/v2/metadata/wordle-apple-touch-icon.png?v=v2504091145",
      "category": "Words",
      "publisher": "The New York Times",
      "description": "Guess the five-letter word in six tries. Color hints tell you which letters are right — a fresh puzzle every day.",
      "winCheck": {
        "type": "storage",
        "keyPrefix": "games-state-wordleV2/",
        "entryPath": "states.*",
        "path": "data.status",
        "equals": "WIN"
      },
      "loseCheck": {
        "type": "storage",
        "keyPrefix": "games-state-wordleV2/",
        "entryPath": "states.*",
        "path": "data.status",
        "equals": "FAIL"
      },
      "scoreButton": {
        "query": "button, [role='button']",
        "text": "Share"
      }
    },
    {
      "slug": "strands",
      "name": "Strands",
      "url": "https://www.nytimes.com/games/strands",
      "matchPatterns": ["https://www.nytimes.com/games/strands*"],
      "captureResults": true,
      "icon": "https://www.nytimes.com/games-assets/v2/metadata/strands-apple-touch-icon.png?v=v2504101308",
      "category": "Words",
      "publisher": "The New York Times",
      "description": "Find the theme words hiding in a grid of letters. Every letter is used exactly once — including the spangram.",
      "winCheck": {
        "type": "storage",
        "keyPrefix": "games-state-strands/",
        "entryPath": "states.*",
        "path": "data.isSolved",
        "equals": true
      },
      "loseCheck": null,
      "scoreButton": {
        "query": "button, [role='button']",
        "text": "Share"
      }
    },
    {
      "slug": "connections",
      "name": "Connections",
      "url": "https://www.nytimes.com/games/connections",
      "matchPatterns": ["https://www.nytimes.com/games/connections*"],
      "captureResults": true,
      "icon": "https://www.nytimes.com/games-assets/v2/metadata/connections-apple-touch-icon.png?v=v2504101308",
      "category": "Words",
      "publisher": "The New York Times",
      "description": "Group sixteen words into four hidden categories. You only get four mistakes, so pick your groups carefully.",
      "winCheck": {
        "type": "storage",
        "keyPrefix": "games-state-connections/",
        "entryPath": "states.*",
        "path": "data.puzzleWon",
        "equals": true
      },
      "loseCheck": {
        "type": "storage",
        "keyPrefix": "games-state-connections/",
        "entryPath": "states.*",
        "path": "data.puzzleComplete",
        "equals": true
      },
      "scoreButton": {
        "query": "button, [role='button']",
        "text": "Share"
      }
    },
    {
      "slug": "mini-crossword",
      "name": "Mini Crossword",
      "url": "https://minicrossword.com/",
      "matchPatterns": ["https://minicrossword.com/*"],
      "captureResults": true,
      "icon": "https://minicrossword.com/favicon-mini-crossword.svg",
      "category": "Words",
      "publisher": "Hey, Good Game",
      "description": "Solve a compact daily crossword edited by Jeff Chen. Most puzzles are 5×5, with larger grids on weekends.",
      "winCheck": {
        "type": "storage",
        "key": "crosswordMini_daily_daily-easy",
        "idPath": "puzzleId",
        "path": "isComplete",
        "equals": true
      },
      "loseCheck": null,
      "scoreButton": {
        "query": "button, [role='button']",
        "text": "Share"
      }
    },
    {
      "slug": "wapo-daily-word-search",
      "name": "Daily Word Search",
      "url": "https://games.washingtonpost.com/games/daily-word-search",
      "matchPatterns": [
        "https://games.washingtonpost.com/games/daily-word-search*"
      ],
      "captureResults": false,
