    {
      "slug": "squaredle-express",
      "name": "Squaredle Express",
      "url": "https://squaredle.app/?level=xp",
      "matchPatterns": ["https://squaredle.app/*"],
      "captureResults": true,
      "icon": "https://squaredle.app/icons/icon-512.png",
      "category": "Words",
      "publisher": "Squaredle",
      "description": "Find every word in a compact 3×3 grid by connecting letters in any direction. A fresh Express puzzle every day.",
      "winCheck": {
        "query": "#board .board.celebrate",
        "text": ""
