{
  "categories": ["Words", "Trivia", "Music"],
  "games": [
    {
      "slug": "wordle",
      "name": "Wordle",
      "url": "https://www.nytimes.com/games/wordle/index.html",
      "icon": "https://www.nytimes.com/games-assets/v2/metadata/wordle-apple-touch-icon.png?v=v2504091145",
      "category": "Words",
      "publisher": "The New York Times",
      "description": "Guess the five-letter word in six tries. Color hints tell you which letters are right — a fresh puzzle every day.",
      "winCheck": {
        "type": "storage",
        "keyPrefix": "games-state-wordleV2/",
        "entryPath": "states.*",
        "path": "data.status",
        "equals": "WIN"
      },
      "loseCheck": {
        "type": "storage",
        "keyPrefix": "games-state-wordleV2/",
        "entryPath": "states.*",
        "path": "data.status",
        "equals": "FAIL"
      },
      "scoreButton": {
        "query": "button, [role='button']",
        "text": "Share"
      }
    },
    {
      "slug": "strands",
      "name": "Strands",
      "url": "https://www.nytimes.com/games/strands",
      "icon": "https://www.nytimes.com/games-assets/v2/metadata/strands-apple-touch-icon.png?v=v2504101308",
      "category": "Words",
      "publisher": "The New York Times",
      "description": "Find the theme words hiding in a grid of letters. Every letter is used exactly once — including the spangram.",
      "winCheck": {
        "type": "storage",
        "keyPrefix": "games-state-strands/",
        "entryPath": "states.*",
        "path": "data.isSolved",
        "equals": true
      },
      "loseCheck": null,
      "scoreButton": {
        "query": "button, [role='button']",
        "text": "Share"
      }
    },
    {
      "slug": "connections",
      "name": "Connections",
      "url": "https://www.nytimes.com/games/connections",
      "icon": "https://www.nytimes.com/games-assets/v2/metadata/connections-apple-touch-icon.png?v=v2504101308",
      "category": "Words",
      "publisher": "The New York Times",
      "description": "Group sixteen words into four hidden categories. You only get four mistakes, so pick your groups carefully.",
      "winCheck": {
        "type": "storage",
        "keyPrefix": "games-state-connections/",
        "entryPath": "states.*",
        "path": "data.puzzleWon",
        "equals": true
      },
      "loseCheck": {
        "type": "storage",
        "keyPrefix": "games-state-connections/",
        "entryPath": "states.*",
        "path": "data.puzzleComplete",
        "equals": true
      },
      "scoreButton": {
        "query": "button, [role='button']",
        "text": "Share"
      }
    },
    {
      "slug": "wiki-game-daily",
      "name": "Wiki Game Daily",
      "url": "https://www.thewikigamedaily.com",
      "icon": "https://www.thewikigamedaily.com/favicon.png",
      "category": "Trivia",
      "publisher": "The Wiki Game",
      "description": "Race across Wikipedia from a start article to a target article in as few clicks as possible. One route, every day.",
      "winCheck": {
        "type": "storage",
        "key": "wikipediaGameStats",
        "path": "daysCompleted",
        "increases": true
      },
      "loseCheck": null,
      "scoreButton": {
        "query": "button, [role='button']",
        "text": [
          "Share",
          "Share result",
          "Share results",
          "Copy result",
          "Copy results",
          "Copy score"
        ]
      }
    },
    {
      "slug": "bandle",
      "name": "Bandle",
      "url": "https://bandle.app/daily",
      "icon": "https://bandle.app/favicon.ico",
      "category": "Music",
      "publisher": "Bandle",
      "description": "Guess the daily song title. Each wrong guess lets more of the track's instruments fade in.",
      "winCheck": {
        "type": "storage",
        "key": "status",
        "idPath": "gameId",
        "path": "win",
        "equals": true
      },
      "loseCheck": {
        "type": "storage",
        "key": "status",
        "idPath": "gameId",
        "path": "loose",
        "equals": true
      },
      "scoreButton": {
        "query": "button, [role='button']",
        "text": "Share"
      }
    },
    {
      "slug": "tower-of-questions",
      "name": "Tower of Questions",
      "url": "https://towerofquestions.com/",
      "icon": "https://towerofquestions.com/favicon.ico",
      "category": "Trivia",
      "publisher": "Tower of Questions",
      "description": "Climb a moonlit tower in this daily trivia game.",
      "winCheck": {
        "type": "storage",
        "keyPrefix": "tower-of-questions:prototype-run:",
        "path": "state.status",
        "equals": "won"
      },
      "loseCheck": {
        "type": "storage",
        "keyPrefix": "tower-of-questions:prototype-run:",
        "path": "state.status",
        "equals": "lost"
      },
      "scoreButton": {
        "query": "button, [role='button']",
        "text": [
          "Share",
          "Share result",
          "Share results",
          "Copy result",
          "Copy results",
          "Copy score"
        ]
      }
    },
    {
      "slug": "krillion",
      "name": "Krillion",
      "url": "https://krillion.io/",
      "icon": "https://krillion.io/icon.png",
      "category": "Trivia",
      "publisher": "Krillion",
      "description": "Seven prompts a day, same for everyone. Rare answers sink you deeper. Obvious ones barely count.",
      "winCheck": {
        "query": "span.text-drift",
        "text": " complete"
      },
      "loseCheck": null,
      "scoreButton": {
        "query": "button, [role='button']",
        "text": [
          "Share",
          "Share result",
          "Share results",
          "Copy result",
          "Copy results",
          "Copy score"
        ]
      }
    }
  ]
}
