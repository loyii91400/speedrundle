    {
      "slug": "verticle",
      "name": "Verticle",
      "url": "https://verticle.netlify.app/",
      "matchPatterns": ["https://verticle.netlify.app/*"],
      "captureResults": true,
      "icon": "https://verticle.netlify.app/logo192.png",
      "category": "Words",
      "publisher": "Verticle",
      "description": "A Wordle variant where the first five guesses are vertical, giving color hints for each column. Solve the daily word in six tries.",
      "winCheck": {
        "type": "storage",
        "key": "gameStats",
        "path": "currentStreak",
        "increases": true
      },
      "loseCheck": {
        "type": "storage",
        "key": "gameStats",
        "path": "gamesFailed",
        "increases": true
      },
      "scoreButton": {
        "query": "button",
        "text": "Share",
        "attempts": 50
      }
    },
    {
      "slug": "wiki-game-daily",
